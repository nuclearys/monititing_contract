DATABASE_URL=postgresql://monitoring:local-development-only@127.0.0.1:55434/monitoring_obligations

# DeepSeek. Ключ хранится только в локальном .env или в секретах окружения.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=8000
