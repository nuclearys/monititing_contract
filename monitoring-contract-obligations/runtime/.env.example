DATABASE_URL=postgresql://monitoring:local-development-only@127.0.0.1:55434/monitoring_obligations

# Authentication: local for development, oidc for Keycloak/production.
AUTH_MODE=local
SESSION_TTL_SECONDS=28800
REDIS_URL=
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/corporate
KEYCLOAK_CLIENT_ID=monitoring-contract-obligations
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:4174/auth/callback
OIDC_DEFAULT_ROLE=observer

# Files: local for development, s3 for S3/MinIO-compatible object storage.
OBJECT_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# DeepSeek. Ключ хранится только в локальном .env или в секретах окружения.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-flash
AI_PROVIDER_TIMEOUT_MS=120000
AI_PROVIDER_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=8000
