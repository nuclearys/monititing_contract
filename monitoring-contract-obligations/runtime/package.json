{
  "name": "monitoring-contract-obligations-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-database.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts",
    "obligations:mark-overdue": "node --env-file-if-exists=.env --import tsx scripts/mark-overdue.ts",
    "worker:documents": "node --env-file-if-exists=.env --import tsx scripts/document-worker.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "node --test tests/api.e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "jose": "^6.2.12",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
